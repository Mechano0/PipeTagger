<Project>
  <!--
    Shared settings for Loader + Core, for Revit 2021 - 2027.

      RevitVersion  = the Revit the add-in is installed into (default 2026)
      ApiVersion    = the Revit API it is compiled against (default = RevitVersion)

    Revit 2021-2024 -> .NET Framework 4.8
    Revit 2025-2026 -> .NET 8
    Revit 2027      -> .NET 10 (needs the .NET 10 SDK; without it build.ps1 compiles
                       2027 against the 2026 API on .NET 8, which Revit 2027 can still load)

    Revit API DLLs come from NuGet (Nice3point.Revit.Api.*), so you can build every
    version without having that Revit installed.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <ApiVersion Condition="'$(ApiVersion)' == ''">$(RevitVersion)</ApiVersion>

    <TargetFramework Condition="'$(ApiVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(ApiVersion)' &gt;= '2025' And '$(ApiVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(ApiVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>

    <!-- RevitAPI itself depends on WPF + WinForms framework assemblies -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>PipeTagger</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

    <!-- Separate bin/obj per Revit version so builds never mix -->
    <BaseIntermediateOutputPath>obj\R$(RevitVersion)\</BaseIntermediateOutputPath>
    <OutputPath>bin\R$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Never compile files generated by other versions' builds -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>

    <RevitInstalled Condition="Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe')">true</RevitInstalled>
    <AddinDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>

    <!-- Compile-time switches for API differences between versions -->
    <DefineConstants>$(DefineConstants);REVIT$(ApiVersion)</DefineConstants>
    <DefineConstants Condition="'$(ApiVersion)' &gt;= '2022'">$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(ApiVersion)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(ApiVersion)' &gt;= '2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only packages: never copied next to the add-in -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(ApiVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(ApiVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Lets the .NET SDK build net48 without Visual Studio's targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
</Project>
